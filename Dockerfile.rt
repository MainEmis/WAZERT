FROM python:3.12-slim

WORKDIR /app

COPY requirements.rt.txt .
RUN pip install --no-cache-dir -r requirements.rt.txt

# Compile proto → waze_pb2.py at build time
COPY waze.proto .
RUN python -m grpc_tools.protoc -I. --python_out=. waze.proto

COPY waze_client.py .

ENTRYPOINT ["python", "-u", "waze_client.py"]
