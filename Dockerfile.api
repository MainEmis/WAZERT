FROM python:3.12-slim

WORKDIR /app

COPY requirements.rt.txt .
RUN pip install --no-cache-dir -r requirements.rt.txt && \
    pip install --no-cache-dir fastapi uvicorn[standard]

COPY waze.proto .
RUN python -m grpc_tools.protoc -I. --python_out=. waze.proto

COPY waze_client.py api.py .

EXPOSE 8000
CMD ["uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8000"]
